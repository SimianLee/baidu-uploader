# ==========================================================
# 百度网盘分批上传工具 · Git 忽略规则
#
# 项目布局：代码和配置在根目录；运行数据全在 data/；测试在 tests/
# ==========================================================

# ---------- 敏感：千万不要提交 ----------
# config.json 含 AppKey / SecretKey 明文
# token.json  含百度账号的 access_token / refresh_token
config.json
token.json
*.token
secret*.json

# ---------- 第三方依赖（用 requirements.txt 重装即可）----------
libs/
site-packages/
venv/
.venv/
env/

# ---------- Python 缓存 ----------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# ---------- 运行数据（data/：进度、断点、锁、日志、预览、完整计划）----------
# 内容随运行状态变，属于本机产物；断点记录更是删了会重复上传
data/

# ---------- 推送日志 ----------
push-logs/

# ---------- 测试 / 临时文件 ----------
# 测试脚本（含 UI 截图）不进公开仓库
tests/
_*
shots/

# ---------- 编辑器 / 系统 ----------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
